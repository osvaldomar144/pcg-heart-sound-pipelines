{
  "audio": {
    "target_sr": 2000,
    "chunk_seconds": 4.0,
    "mono": true
  },
  "tf": {
    "n_fft": 512,
    "hop_length": 128,
    "win_length": 512,
    "window": "hann",
    "n_mels": 64,
    "fmin": 20,
    "fmax": 800
  },
  "pipelines": {
    "bandpass_mel": {
      "steps": ["load","resample","to_mono","bandpass","normalize_rms","chunk_or_pad","mel","log"],
      "bandpass": {"lowcut": 20, "highcut": 400, "order": 4}
    },
    "fft_denoise_mel": {
      "steps": ["load","resample","to_mono","fft_denoise","normalize_rms","chunk_or_pad","mel","log"],
      "fft_denoise": {"prop_decrease": 0.8}
    },
    "wavelet_denoise_mel": {
      "steps": ["load","resample","to_mono","wavelet_denoise","normalize_rms","chunk_or_pad","mel","log"],
      "wavelet": {"wavelet": "db6", "level": 4, "mode": "soft"}
    }
  }
}
